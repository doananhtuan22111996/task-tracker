    <string name="settings_help_faq">Help &amp; FAQ</string>
    <string name="settings_help_faq_desc">Get answers to common questions</string>
    <string name="title_help_faq">Help &amp; FAQ</string>
    <string name="help_section_getting_started">Getting Started</string>
    <string name="help_q_create_task">How do I create my first task?</string>
    <string name="help_a_create_task">Tap the + button on the home screen. Add a title, optional description, tag, and priority, then tap Save.</string>
    <string name="help_q_need_account">Do I need an account?</string>
    <string name="help_a_need_account">No. Task Tracker works entirely offline. No sign-up, no login, no subscription.</string>
    <string name="help_section_managing_tasks">Managing Tasks</string>
    <string name="help_q_filter_by_tag">How do I filter tasks by tag?</string>
    <string name="help_a_filter_by_tag">Tap a tag chip in the row below the top bar. Tap again to clear the filter.</string>
    <string name="help_q_change_priority">How do I change a task\'s priority?</string>
    <string name="help_a_change_priority">Open the task editor (tap a task) and select Low, Medium, or High.</string>
    <string name="help_q_multi_select">Can I select multiple tasks at once?</string>
    <string name="help_a_multi_select">Yes. Long-press any task to enter multi-select mode, then tap tasks to select them.</string>
    <string name="help_section_calendar">Calendar</string>
    <string name="help_q_calendar_where">Where is the calendar view?</string>
    <string name="help_a_calendar_where">Tap the Calendar tab in the bottom nav to see your tasks on a month grid. Tap any day to view that day\'s agenda.</string>
    <string name="help_q_calendar_dots">What do the dots on each day mean?</string>
    <string name="help_a_calendar_dots">Each dot represents a different priority level present on that day. Dots are ordered with the highest priority on the left. Up to three dots show; extra priorities appear as "+N".</string>
    <string name="help_q_calendar_projection">Why do I see future repeating tasks I haven\'t created yet?</string>
    <string name="help_a_calendar_projection">Repeating tasks are projected onto their upcoming due dates so you can plan ahead. Tap a projected occurrence to turn it into a real task on that date — you can then edit, complete, or archive it like any other task.</string>
    <string name="help_q_calendar_add_for_day">Can I add a task for a specific day?</string>
    <string name="help_a_calendar_add_for_day">Yes. Tap the day to open the day sheet, then tap the + button — the new task is pre-filled with that date. An empty calendar also shows an "Add a task" card above the grid that starts with today\'s date.</string>
    <string name="help_section_subtasks">Subtasks</string>
    <string name="help_q_add_subtasks">How do I add subtasks to a task?</string>
    <string name="help_a_add_subtasks">Open a task and scroll to the Subtasks section. Type in the "Add subtask" row and press Done to add another.</string>
    <string name="help_q_reorder_subtasks">Can I reorder subtasks?</string>
    <string name="help_a_reorder_subtasks">Yes. Long-press the drag handle on the right of any subtask and drag. With TalkBack, use the "Move up" / "Move down" custom actions.</string>
    <string name="help_q_subtasks_recurrence">What happens to subtasks when a recurring task regenerates?</string>
    <string name="help_a_subtasks_recurrence">The next occurrence keeps the same subtasks, all reset to unchecked.</string>
    <string name="help_q_subtasks_autocomplete">Does completing every subtask complete the parent task?</string>
    <string name="help_a_subtasks_autocomplete">No. Parent and subtask completion are independent — you complete the parent explicitly.</string>
    <string name="help_section_batch_ops">Batch Operations</string>
    <string name="help_q_bulk_actions">How do I act on multiple tasks at once?</string>
    <string name="help_a_bulk_actions">Long-press a task to enter selection mode, tap more tasks to add or remove them, then use the top bar icons or overflow menu to complete, archive, delete, apply a tag, or change priority.</string>
    <string name="help_q_bulk_tag_missing">Why doesn\'t my new tag show in the apply-tag sheet?</string>
    <string name="help_a_bulk_tag_missing">The sheet lists tags already used by at least one task. Add the tag to a task via the editor first — it will then appear in the bulk sheet.</string>
    <string name="help_q_bulk_undo">Can I undo a bulk archive?</string>
    <string name="help_a_bulk_undo">Yes. A Snackbar appears after archiving — tap Undo to restore the whole batch. Bulk delete requires confirmation and cannot be undone.</string>
    <string name="help_q_exit_selection">How do I exit selection mode?</string>
    <string name="help_a_exit_selection">Tap the X in the top bar, press the back gesture, or use Select All and then tap any task to deselect.</string>
    <string name="help_section_reminders">Reminders</string>
    <string name="help_q_no_reminder">Why didn\'t I receive a reminder?</string>
    <string name="help_a_no_reminder">Ensure notifications are enabled for Task Tracker in your device Settings. Reminders only fire if a due date and reminder time are set.</string>
    <string name="help_q_reminder_no_due">Can I set a reminder without a due date?</string>
    <string name="help_a_reminder_no_due">No. A due date is required before a reminder option appears.</string>
    <string name="help_section_archive">Archive</string>
    <string name="help_q_archive_task">What happens when I archive a task?</string>
    <string name="help_a_archive_task">Archived tasks are removed from your main list but not deleted. Find them in the Archive screen.</string>
    <string name="help_q_restore_archived">Can I restore an archived task?</string>
    <string name="help_a_restore_archived">Yes. Open Archive, tap the task, and choose Restore.</string>
    <string name="help_section_stats">Stats</string>
    <string name="help_q_completion_rate">What does "Completion Rate" mean?</string>
    <string name="help_a_completion_rate">It\'s the percentage of all tasks (excluding archived) that are marked complete.</string>
    <string name="help_q_tap_stat_card">Can I tap a stat card?</string>
    <string name="help_a_tap_stat_card">Yes. Tapping a card takes you to a pre-filtered task list (e.g., tapping "Overdue" shows only overdue tasks).</string>
    <string name="help_section_backup">Backup &amp; Export</string>
    <string name="help_q_backup_tasks">How do I back up my tasks?</string>
    <string name="help_a_backup_tasks">Go to Settings → Backup &amp; Restore → Export Backup. A JSON file is saved to your chosen location.</string>
    <string name="help_q_export_csv">Can I export to a spreadsheet?</string>
    <string name="help_a_export_csv">Yes. Settings → Export as CSV produces a file compatible with Excel and Google Sheets.</string>

