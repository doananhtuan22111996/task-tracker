<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud-backup uses exclude-only rules: with no <include>, the policy is "include
  everything except the excluded paths" per Android Auto Backup docs. Task content
  stays on-device by design, and the diagnostics opt-in (privacy.preferences_pb,
  FB-04) must NOT travel via cloud backup so a new device starts at the "OFF by
  default" state the Privacy Policy (FB-18) commits to.

  Device-transfer uses an include allow-list: only paths explicitly listed travel.
  privacy.preferences_pb is omitted from the allow-list, which is sufficient to
  exclude it (no <exclude> entry needed — lint flags excludes outside an included
  path with FullBackupContent error). settings.preferences_pb is included so theme,
  locale, and other non-sensitive prefs migrate; task_tracker.db is included so the
  user's tasks survive device-to-device migration.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="task_tracker.db" />
        <exclude domain="database" path="task_tracker.db-shm" />
        <exclude domain="database" path="task_tracker.db-wal" />
        <exclude domain="sharedpref" path="settings.preferences_pb" />
        <exclude domain="sharedpref" path="privacy.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="task_tracker.db" />
        <include domain="sharedpref" path="settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
