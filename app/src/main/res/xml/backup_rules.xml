<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules consulted on API 26-30. (API ≥ 31 uses data_extraction_rules.xml.)
  Mirrors data_extraction_rules.xml's cloud-backup excludes so legacy-API installs honor
  the same on-device-only posture: task content stays on the device, and the diagnostics
  opt-in (privacy.preferences_pb, FB-04) doesn't travel via cloud backup so a new device
  starts at the "OFF by default" state the Privacy Policy (FB-18) commits to.
-->
<full-backup-content>
    <exclude domain="database" path="task_tracker.db" />
    <exclude domain="database" path="task_tracker.db-shm" />
    <exclude domain="database" path="task_tracker.db-wal" />
    <exclude domain="sharedpref" path="settings.preferences_pb" />
    <exclude domain="sharedpref" path="privacy.preferences_pb" />
    <exclude domain="sharedpref" path="widget.preferences_pb" />
</full-backup-content>
