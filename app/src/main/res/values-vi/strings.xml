    <!-- Help & FAQ (SPEC-O03) -->
    <string name="cd_faq_expanded">đã mở rộng</string>
    <string name="cd_faq_collapsed">đã thu gọn</string>
    <string name="settings_help_faq">Trợ giúp &amp; FAQ</string>
    <string name="settings_help_faq_desc">Tìm câu trả lời cho các câu hỏi thường gặp</string>
    <string name="title_help_faq">Trợ giúp &amp; FAQ</string>
    <string name="help_section_getting_started">Bắt đầu</string>
    <string name="help_q_create_task">Làm thế nào để tạo công việc đầu tiên?</string>
    <string name="help_a_create_task">Nhấn nút + trên màn hình chính. Thêm tiêu đề, mô tả tùy chọn, nhãn và mức ưu tiên, rồi nhấn Lưu.</string>
    <string name="help_q_need_account">Tôi có cần tài khoản không?</string>
    <string name="help_a_need_account">Không. Task Tracker hoạt động hoàn toàn ngoại tuyến. Không cần đăng ký, không cần đăng nhập, không cần thuê bao.</string>
    <string name="help_section_managing_tasks">Quản lý công việc</string>
    <string name="help_q_filter_by_tag">Làm thế nào để lọc công việc theo nhãn?</string>
    <string name="help_a_filter_by_tag">Nhấn vào chip nhãn ở hàng bên dưới thanh trên cùng. Nhấn lại để xóa bộ lọc.</string>
    <string name="help_q_change_priority">Làm thế nào để thay đổi mức ưu tiên của công việc?</string>
    <string name="help_a_change_priority">Mở trình chỉnh sửa công việc (nhấn vào một công việc) và chọn Thấp, Trung bình hoặc Cao.</string>
    <string name="help_q_multi_select">Tôi có thể chọn nhiều công việc cùng lúc không?</string>
    <string name="help_a_multi_select">Có. Nhấn giữ bất kỳ công việc nào để vào chế độ chọn nhiều, rồi nhấn vào các công việc để chọn.</string>
    <string name="help_section_subtasks">Công việc phụ</string>
    <string name="help_q_add_subtasks">Làm thế nào để thêm công việc phụ vào một công việc?</string>
    <string name="help_a_add_subtasks">Mở một công việc và kéo xuống phần Công việc phụ. Gõ vào ô "Thêm công việc phụ" rồi nhấn Xong để thêm mục tiếp theo.</string>
    <string name="help_q_reorder_subtasks">Tôi có thể sắp xếp lại các công việc phụ không?</string>
    <string name="help_a_reorder_subtasks">Có. Nhấn giữ biểu tượng kéo ở bên phải một công việc phụ và kéo. Với TalkBack, dùng các hành động "Di chuyển lên" / "Di chuyển xuống".</string>
    <string name="help_q_subtasks_recurrence">Điều gì xảy ra với các công việc phụ khi một công việc lặp lại được tạo lại?</string>
    <string name="help_a_subtasks_recurrence">Lần tới giữ nguyên các công việc phụ đó, tất cả được đặt lại thành chưa hoàn thành.</string>
    <string name="help_q_subtasks_autocomplete">Hoàn thành tất cả công việc phụ có tự hoàn thành công việc cha không?</string>
    <string name="help_a_subtasks_autocomplete">Không. Công việc cha và công việc phụ hoàn thành độc lập — bạn phải hoàn thành công việc cha rõ ràng.</string>
    <string name="help_section_batch_ops">Thao tác hàng loạt</string>
    <string name="help_q_bulk_actions">Làm sao thao tác nhiều công việc cùng lúc?</string>
    <string name="help_a_bulk_actions">Nhấn giữ một công việc để vào chế độ chọn, nhấn thêm các công việc khác để thêm hoặc bỏ chọn, rồi dùng các biểu tượng trên thanh công cụ hoặc trình đơn tràn để hoàn thành, lưu trữ, xóa, áp dụng thẻ hoặc thay đổi mức ưu tiên.</string>
    <string name="help_q_bulk_tag_missing">Tại sao thẻ mới của tôi không hiển thị trong hộp áp dụng thẻ?</string>
    <string name="help_a_bulk_tag_missing">Hộp chỉ liệt kê những thẻ đã được dùng trên ít nhất một công việc. Hãy thêm thẻ vào một công việc qua trình chỉnh sửa trước — thẻ sẽ xuất hiện trong hộp hàng loạt sau đó.</string>
    <string name="help_q_bulk_undo">Tôi có thể hoàn tác lưu trữ hàng loạt không?</string>
    <string name="help_a_bulk_undo">Có. Sau khi lưu trữ, một Snackbar xuất hiện — nhấn Hoàn tác để khôi phục cả lô. Xóa hàng loạt cần xác nhận và không thể hoàn tác.</string>
    <string name="help_q_exit_selection">Làm sao thoát khỏi chế độ chọn?</string>
    <string name="help_a_exit_selection">Nhấn dấu X trên thanh công cụ, dùng cử chỉ quay lại, hoặc nhấn vào một công việc đã chọn để bỏ chọn.</string>
    <string name="help_section_reminders">Nhắc việc</string>
    <string name="help_q_no_reminder">Tại sao tôi không nhận được nhắc việc?</string>
    <string name="help_a_no_reminder">Hãy đảm bảo đã bật thông báo cho Task Tracker trong cài đặt thiết bị. Nhắc việc chỉ hoạt động khi đã đặt hạn hoàn thành và thời gian nhắc.</string>
    <string name="help_q_reminder_no_due">Tôi có thể đặt nhắc việc mà không có hạn hoàn thành không?</string>
    <string name="help_a_reminder_no_due">Không. Cần có hạn hoàn thành trước khi tùy chọn nhắc việc xuất hiện.</string>
    <string name="help_section_archive">Lưu trữ</string>
    <string name="help_q_archive_task">Điều gì xảy ra khi tôi lưu trữ công việc?</string>
    <string name="help_a_archive_task">Công việc đã lưu trữ được xóa khỏi danh sách chính nhưng không bị xóa vĩnh viễn. Tìm chúng trong màn hình Lưu trữ.</string>
    <string name="help_q_restore_archived">Tôi có thể khôi phục công việc đã lưu trữ không?</string>
    <string name="help_a_restore_archived">Có. Mở Lưu trữ, nhấn vào công việc và chọn Khôi phục.</string>
    <string name="help_section_stats">Thống kê</string>
    <string name="help_q_completion_rate">"Tỷ lệ hoàn thành" nghĩa là gì?</string>
    <string name="help_a_completion_rate">Đó là phần trăm tất cả công việc (không tính đã lưu trữ) được đánh dấu là hoàn thành.</string>
    <string name="help_q_tap_stat_card">Tôi có thể nhấn vào thẻ thống kê không?</string>
    <string name="help_a_tap_stat_card">Có. Nhấn vào một thẻ sẽ đưa bạn đến danh sách công việc đã lọc (ví dụ: nhấn "Quá hạn" chỉ hiển thị các công việc quá hạn).</string>
    <string name="help_section_backup">Sao lưu &amp; Xuất</string>
    <string name="help_q_backup_tasks">Làm thế nào để sao lưu công việc?</string>
    <string name="help_a_backup_tasks">Vào Cài đặt → Sao lưu &amp; Khôi phục → Xuất bản sao lưu. Một tệp JSON sẽ được lưu tại vị trí bạn chọn.</string>
    <string name="help_q_export_csv">Tôi có thể xuất sang bảng tính không?</string>
    <string name="help_a_export_csv">Có. Cài đặt → Xuất dạng CSV tạo ra tệp tương thích với Excel và Google Sheets.</string>

