    <!-- Feature Tips (SPEC-O02) -->
    <string name="tip_fab_create_task">अपना पहला कार्य बनाने के लिए + दबाएँ। व्यवस्थित रहने के लिए एक टैग और प्राथमिकता जोड़ें।</string>
    <string name="tip_tag_chips_filter">अपने कार्यों को फ़िल्टर करने के लिए किसी टैग चिप पर टैप करें। फ़िल्टर हटाने के लिए फिर से टैप करें।</string>
    <string name="tip_stats_cards">फ़िल्टर की गई कार्य सूची पर जाने के लिए किसी भी आँकड़ा कार्ड पर टैप करें।</string>
