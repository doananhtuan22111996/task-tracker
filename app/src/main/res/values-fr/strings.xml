    <string name="title_help_faq">Aide &amp; FAQ</string>
    <string name="help_section_getting_started">Pour commencer</string>
    <string name="help_q_create_task">Comment créer ma première tâche ?</string>
    <string name="help_a_create_task">Touchez le bouton + sur l\'écran d\'accueil. Ajoutez un titre, une description facultative, un tag et une priorité, puis touchez Enregistrer.</string>
    <string name="help_q_need_account">Ai-je besoin d\'un compte ?</string>
    <string name="help_a_need_account">Non. Task Tracker fonctionne entièrement hors ligne. Pas d\'inscription, pas de connexion, pas d\'abonnement.</string>
